{
  "components": {
    "schemas": {
      "DependencyStatus": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "DependencyStatus",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Money": {
        "properties": {
          "amount": {
            "description": "Decimal string, e.g. '542.30'",
            "title": "Amount",
            "type": "string"
          },
          "currency": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "title": "Money",
        "type": "object"
      },
      "OfferPublic": {
        "description": "Client-facing offer (no provider_payload).",
        "properties": {
          "baggage_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baggage Summary"
          },
          "cabin_class": {
            "enum": [
              "economy",
              "premium_economy",
              "business",
              "first"
            ],
            "title": "Cabin Class",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Money"
          },
          "provider": {
            "enum": [
              "mock",
              "amadeus",
              "duffel"
            ],
            "title": "Provider",
            "type": "string"
          },
          "slices": {
            "items": {
              "$ref": "#/components/schemas/Slice"
            },
            "title": "Slices",
            "type": "array"
          },
          "validating_airline": {
            "title": "Validating Airline",
            "type": "string"
          }
        },
        "required": [
          "id",
          "provider",
          "price",
          "cabin_class",
          "validating_airline",
          "slices"
        ],
        "title": "OfferPublic",
        "type": "object"
      },
      "Passengers": {
        "properties": {
          "adults": {
            "default": 1,
            "maximum": 9.0,
            "minimum": 1.0,
            "title": "Adults",
            "type": "integer"
          },
          "children": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Children",
            "type": "integer"
          },
          "infants": {
            "default": 0,
            "maximum": 9.0,
            "minimum": 0.0,
            "title": "Infants",
            "type": "integer"
          }
        },
        "title": "Passengers",
        "type": "object"
      },
      "ReadyResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyStatus"
            },
            "title": "Checks",
            "type": "object"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "environment"
        ],
        "title": "ReadyResponse",
        "type": "object"
      },
      "SearchFilters": {
        "properties": {
          "airlines": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Airlines"
          },
          "max_duration_minutes": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Duration Minutes"
          },
          "max_price": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Price"
          },
          "max_stops": {
            "anyOf": [
              {
                "maximum": 3.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Stops"
          }
        },
        "title": "SearchFilters",
        "type": "object"
      },
      "SearchRequest": {
        "properties": {
          "cabin_class": {
            "default": "economy",
            "enum": [
              "economy",
              "premium_economy",
              "business",
              "first"
            ],
            "title": "Cabin Class",
            "type": "string"
          },
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          },
          "departure_date": {
            "format": "date",
            "title": "Departure Date",
            "type": "string"
          },
          "destination": {
            "title": "Destination",
            "type": "string"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SearchFilters"
              },
              {
                "type": "null"
              }
            ]
          },
          "origin": {
            "title": "Origin",
            "type": "string"
          },
          "page": {
            "default": 1,
            "minimum": 1.0,
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "default": 20,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Page Size",
            "type": "integer"
          },
          "passengers": {
            "$ref": "#/components/schemas/Passengers"
          },
          "return_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Return Date"
          },
          "sort": {
            "default": "price_asc",
            "enum": [
              "price_asc",
              "price_desc",
              "duration_asc",
              "departure_asc"
            ],
            "title": "Sort",
            "type": "string"
          },
          "trip_type": {
            "enum": [
              "one_way",
              "round_trip"
            ],
            "title": "Trip Type",
            "type": "string"
          }
        },
        "required": [
          "trip_type",
          "origin",
          "destination",
          "departure_date"
        ],
        "title": "SearchRequest",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "cache": {
            "enum": [
              "HIT",
              "MISS"
            ],
            "title": "Cache",
            "type": "string"
          },
          "cached_at": {
            "title": "Cached At",
            "type": "string"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "offers": {
            "items": {
              "$ref": "#/components/schemas/OfferPublic"
            },
            "title": "Offers",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "page_size": {
            "title": "Page Size",
            "type": "integer"
          },
          "price_disclaimer": {
            "default": "Prices are estimates and may change before booking.",
            "title": "Price Disclaimer",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          },
          "stale": {
            "default": false,
            "title": "Stale",
            "type": "boolean"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "cache",
          "cached_at",
          "currency",
          "total",
          "page",
          "page_size",
          "offers"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "Segment": {
        "properties": {
          "arrive_at": {
            "format": "date-time",
            "title": "Arrive At",
            "type": "string"
          },
          "depart_at": {
            "format": "date-time",
            "title": "Depart At",
            "type": "string"
          },
          "destination": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Destination",
            "type": "string"
          },
          "duration_minutes": {
            "minimum": 1.0,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "flight_number": {
            "title": "Flight Number",
            "type": "string"
          },
          "marketing_carrier": {
            "maxLength": 3,
            "minLength": 2,
            "title": "Marketing Carrier",
            "type": "string"
          },
          "origin": {
            "maxLength": 3,
            "minLength": 3,
            "title": "Origin",
            "type": "string"
          }
        },
        "required": [
          "origin",
          "destination",
          "depart_at",
          "arrive_at",
          "marketing_carrier",
          "flight_number",
          "duration_minutes"
        ],
        "title": "Segment",
        "type": "object"
      },
      "Slice": {
        "properties": {
          "direction": {
            "enum": [
              "outbound",
              "inbound"
            ],
            "title": "Direction",
            "type": "string"
          },
          "duration_minutes": {
            "minimum": 1.0,
            "title": "Duration Minutes",
            "type": "integer"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/Segment"
            },
            "minItems": 1,
            "title": "Segments",
            "type": "array"
          },
          "stops": {
            "minimum": 0.0,
            "title": "Stops",
            "type": "integer"
          }
        },
        "required": [
          "direction",
          "duration_minutes",
          "stops",
          "segments"
        ],
        "title": "Slice",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Airline search API",
    "title": "WingSaver API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health_v1_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health V1 Api V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Versioned liveness (prefer unversioned GET /health for probes)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/offers/{offer_id}": {
      "get": {
        "operationId": "get_offer_api_v1_offers__offer_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "offer_id",
            "required": true,
            "schema": {
              "title": "Offer Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferPublic"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get offer detail from local/Redis offer store",
        "tags": [
          "offers"
        ]
      }
    },
    "/api/v1/ready": {
      "get": {
        "operationId": "ready_api_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "One or more required dependencies failed"
          }
        },
        "summary": "Readiness checks (Redis required in staging/production)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/search": {
      "post": {
        "operationId": "search_flights_api_v1_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search flights (server-side filter/sort/page)",
        "tags": [
          "search"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness for platform/uptime probes (no dependency checks).",
        "operationId": "root_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Root Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Unversioned liveness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
