# Copy to apps/api/.env and apps/web/.env.local as needed.
# Never commit real secrets.

# --- Shared ---
# local | staging | production
ENVIRONMENT=local

# --- API (apps/api) ---
# CORS: comma-separated exact origins (plain string, not JSON required)
# Example multi: CORS_ORIGINS=http://localhost:3000,https://staging.example.com
CORS_ORIGINS=http://localhost:3000
# Optional regex for Vercel preview origins (staging only)
# CORS_ORIGIN_REGEX=https://wingsaver(-git-[\w-]+)?-[\w-]+\.vercel\.app

# Redis (docker-compose maps 6379)
REDIS_URL=redis://localhost:6379/0

# Postgres (docker-compose; use Neon pooled URL in cloud)
DATABASE_URL=postgresql+asyncpg://wingsaver:wingsaver@localhost:5432/wingsaver
# Direct (non-pooled) URL for Alembic migrations in cloud
# DATABASE_URL_DIRECT=postgresql+asyncpg://...

# Auth (generate a long random secret for non-local envs)
JWT_SECRET=change-me-in-production-use-long-random-string
AUTH_REGISTRATION_ENABLED=false

# Flight provider: mock | amadeus | duffel
FLIGHT_PROVIDER=mock
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# AMADEUS_HOSTNAME=test

# Cache TTLs (seconds)
SEARCH_CACHE_TTL_SECONDS_MOCK=900
SEARCH_CACHE_TTL_SECONDS_LIVE=180

# Observability
# SENTRY_DSN=https://...@sentry.io/...
# Leave unset locally to disable Sentry
LOG_LEVEL=INFO

# Trusted proxy hops (verify on FastAPI Cloud staging)
TRUSTED_PROXY_HOPS=1

# --- Web (apps/web) — Vite exposes only VITE_* to the browser ---
# Copy to apps/web/.env.local as needed
VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_SENTRY_DSN=
